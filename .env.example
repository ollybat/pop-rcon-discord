# Spinback pop bot - copy this file to .env and fill it in.
# Only DISCORD_TOKEN is strictly required: everything else can be set up in Discord with /setup.

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional: register the slash commands in this one server (instant). Leave empty for global.
# Global commands can take up to an hour to appear the first time.
DISCORD_GUILD_ID=

# !prefix commands (for example !pop). Needs the Message Content intent enabled in the
# developer portal -> Bot -> Privileged Gateway Intents.
PREFIX_COMMANDS_ENABLED=true
PREFIX=!

# Optional: IDs of bot owners who may also run /setup. Comma separated.
BOT_OWNER_IDS=

# --- Rust server (optional shortcut for slot 1) -------------------------------
# /setup is the normal way to add servers. Fill these in to have one server ready
# before the first /setup, or leave them empty and do everything in Discord.
# Start the Rust server with: +rcon.web 1 +rcon.ip 0.0.0.0 +rcon.port 28016 +rcon.password "yourpassword"
RCON_HOST=
RCON_PORT=28016
RCON_PASSWORD=
RCON_NAME=Spinback 5X EU
RCON_TIMEOUT_MS=15000
RCON_MAX_RECONNECT_DELAY_MS=30000

# Optional: mirror in-game Rust chat into this Discord channel id.
RCON_CHAT_CHANNEL_ID=

# --- Bot behaviour -----------------------------------------------------------
# One poll covers the status line, /pop and the join and leave logs. Minimum 5 seconds.
POLL_INTERVAL_SECONDS=20

# Where the per-server settings from /setup are stored.
DATA_DIR=./data

LOG_LEVEL=info
LOG_TIMESTAMPS=true

# --- Activity / status line --------------------------------------------------
PRESENCE_ENABLED=true

# Optional: the server whose activity is shown. Empty = the first server that has /setup data.
PRESENCE_GUILD_ID=

# 1, 2 or 3 for one server, or "all" to add every server together.
PRESENCE_SERVER_SLOT=1

# Show the yellow "resting" state while the bot is reconnecting.
PRESENCE_RESTING_ON_RECONNECT=false

# {players} {max} {queued} {joining} {uptime} {servers} are filled in with live values.
PRESENCE_ONLINE_FORMAT=🟢 RCON┆👥  {players}/{max} ⏳{queued}/{joining}
PRESENCE_OFFLINE_FORMAT=🔴 RCON┆OFFLINE
PRESENCE_RESTING_FORMAT=🟡 RCON┆RESTING

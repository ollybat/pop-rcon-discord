# ---------------------------------------------------------------------------
# The public health endpoint (optional but recommended on a free host)
# ---------------------------------------------------------------------------
# Keeps a small HTTP server up so the address your host gives you answers
# ("app unreachable" otherwise) and gives /ping something real to call back.
WEB_ENABLED=true
# Defaults to SERVER_PORT, which bot-hosting and most panels hand you. 0 = pick one.
WEB_PORT=

# The address in your browser, e.g. https://nyksp9z6p1.apps.bot-hosting.cloud
# /ping calls this URL and reports the status code and how long it took.
PUBLIC_URL=

# 🎧 Spinback pop bot - environment file
#
# "npm install", then put your bot token below, then "npm start".
# That is all this file needs: staff roles, log channels and up to three servers are
# configured in Discord with the /setup wizard (which stores them in DATA_DIR, not here).
#
# Copy me:  cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────
# Discord developer portal → your app → Bot → Reset Token. One line, no quotes.
DISCORD_TOKEN=

# ─── Nice to have ────────────────────────────────────────────────────────────
# Register the slash commands in this one server so they show up instantly, instead of
# waiting up to an hour for global commands.
DISCORD_GUILD_ID=

# !pop, the one prefix command. Needs the Message Content intent:
# developer portal → Bot → Privileged Gateway Intents.
PREFIX_COMMANDS_ENABLED=true
PREFIX=!

# User ids that may also run /setup, next to the Discord server owner. Comma separated.
BOT_OWNER_IDS=

# ─── One bot, one Discord server ─────────────────────────────────────────────
# The bot only answers in the server that owns it. Two ways to say which:
#
#   1. ALLOWED_GUILD_IDS names it exactly. Comma separated, and the strictest answer.
#   2. Leave it empty and the bot locks itself to the server whose /setup has been saved.
#      Before anything is saved it is open, because nobody has claimed it yet.
#
# Anything else is refused politely: no commands, no stored configuration, no relay.
# Wipe the bot from a server you do not want with LEAVE_UNKNOWN_GUILDS=true.
ALLOWED_GUILD_IDS=
LEAVE_UNKNOWN_GUILDS=false

# ─── Direct messages ─────────────────────────────────────────────────────────
# Answer anyone who DMs the bot, and pass the message on to the clan owners (a DM each,
# plus the staff channel when /setup set one). An owner answers with:
#   !reply <user id> <your answer>          # the bot DMs it to that member
DM_ENABLED=true
# Extra user ids to notify too, on top of each Discord server owner and BOT_OWNER_IDS.
DM_FORWARD_IDS=
# Forward DMs from people who are in none of your servers. Off by default (spam guard).
DM_FORWARD_STRANGERS=false
# Seconds between two automatic answers to the same person (30 minimum).
DM_REPLY_COOLDOWN_SECONDS=300

# Where /setup saves roles, channels and servers (one JSON file per Discord server).
DATA_DIR=./data

# One poll drives the status line, /pop and the join/leave logs. Minimum 5 seconds.
POLL_INTERVAL_SECONDS=20

LOG_LEVEL=info
LOG_TIMESTAMPS=true

# Optional: mirror in-game Rust chat into this Discord channel id.
RCON_CHAT_CHANNEL_ID=

# ─── The "Watching" status line ──────────────────────────────────────────────
PRESENCE_ENABLED=true

# Optional: which Discord server's servers drive the activity line.
# Empty = the first server that has /setup data.
PRESENCE_GUILD_ID=

# 1, 2 or 3 for a single server, or "all" to add every server together.
PRESENCE_SERVER_SLOT=1

# Show 🟡 while the bot is reconnecting instead of 🔴.
PRESENCE_RESTING_ON_RECONNECT=false

# Placeholders: {players} {max} {maxPlayers} {queued} {joining} {uptime} {servers}
# Discord renders an activity name on one line and cuts it at 128 characters.
PRESENCE_ONLINE_FORMAT=🟢 RCON┆👥  {players}/{max} ⏳{queued}/{joining}
PRESENCE_OFFLINE_FORMAT=🔴 RCON┆OFFLINE
PRESENCE_RESTING_FORMAT=🟡 RCON┆RESTING

# ─── Advanced: pre-fill server slot 1 ────────────────────────────────────────
# You do NOT need any of this. /setup saves servers properly (with a Test button), so
# leave these empty unless you want slot 1 ready before the first /setup - for example
# on a fresh host, so the status line shows something immediately.
#
# Start the Rust server with:
#   +rcon.web 1 +rcon.ip 0.0.0.0 +rcon.port 28016 +rcon.password "yourpassword"
RCON_HOST=
RCON_PORT=28016
RCON_PASSWORD=
RCON_NAME=Spinback 5X EU
RCON_TIMEOUT_MS=15000
RCON_MAX_RECONNECT_DELAY_MS=30000

# ─── MCP server (optional) ──────────────────────────────────────────────────────
# The bot ships a small Model Context Protocol server so an AI client (Claude Desktop,
# Claude Code, Codex, ...) can read the same Rust servers over stdio:
#
#   DATA_DIR=./data node mcp/server.js            # tools: list_servers, server_status,
#                                                 # players, pop_report, records,
#                                                 # server_save, broadcast
#   node mcp/server.js --allow-rcon               # adds a raw rcon tool
#
# It reads the very same servers /setup saves, plus RCON_HOST/RCON_PORT/RCON_PASSWORD
# below as a single-server fallback. No Discord token needed.
MCP_ALLOW_ANY_RCON=0
MCP_RCON_TIMEOUT_MS=10000

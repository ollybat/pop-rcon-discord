# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Optional. Defaults to the application ID the bot reports at login.
DISCORD_APP_ID=
# Optional. Set this to register the slash commands in one server instantly.
# Leave empty to register them globally (can take up to an hour to appear).
DISCORD_GUILD_ID=
# Optional. Comma-separated role IDs allowed to use the commands.
# Leave empty to let anyone who can see the command use it.
COMMAND_ROLE_IDS=
# Optional. Channel ID where in-game chat and connection events are relayed.
CONSOLE_CHANNEL_ID=

# ── Rust dedicated server WebRCON ────────────────────────────────────────────
RCON_HOST=127.0.0.1
RCON_PORT=28016
RCON_PASSWORD=
RCON_TIMEOUT_MS=15000
RCON_MAX_RECONNECT_DELAY_MS=30000

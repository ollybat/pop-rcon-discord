# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Optional. Channel ID where in-game chat and connection events are relayed.
CONSOLE_CHANNEL_ID=

# ── Rust dedicated server WebRCON ────────────────────────────────────────────
RCON_HOST=127.0.0.1
RCON_PORT=28016
RCON_PASSWORD=
RCON_TIMEOUT_MS=15000
RCON_MAX_RECONNECT_DELAY_MS=30000

# ── Bot status ("Watching ...") ──────────────────────────────────────────────
PRESENCE_ENABLED=true
# How often the server is polled for its player counts, in seconds (minimum 5).
PRESENCE_INTERVAL_SECONDS=15
# Also show the yellow RESTING state while the bot is waiting to reconnect.
PRESENCE_RESTING_ON_RECONNECT=false
# Templates. Placeholders: {players} {max} {queued} {joining} {uptime}
PRESENCE_ONLINE_FORMAT=🟢 RCON┆👥  {players}/{max} ⏳{queued}/{joining}
PRESENCE_OFFLINE_FORMAT=🔴 RCON┆OFFLINE
PRESENCE_RESTING_FORMAT=🟡 RCON┆RESTING

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
LOG_TIMESTAMPS=true

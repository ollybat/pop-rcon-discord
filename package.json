  "private": true,
  "description": "Spinback pop bot - live Rust server population in Discord, with /setup, !pop, a record book and an MCP server",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {

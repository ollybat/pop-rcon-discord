{
  "name": "pop-rcon-discord",
  "version": "0.4.0",
  "private": true,
  "description": "Discord bot for Rust dedicated servers: live WebRCON status, /setup wizard, !pop player reports and role-gated staff commands",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
